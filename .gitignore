# Python
__pycache__/
*.py[cod]
*$py.class

# Generated by uitk's ui loader (compiled from the sibling .ui at load time)
*_ui.py

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
*.whl

# Testing / type-check caches
.pytest_cache/
.mypy_cache/
.coverage

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Backups
*.bak

# Test scratch artifacts (every sibling package ignores this dir)
test/temp_tests/*
!test/temp_tests/.gitkeep
